#!/bin/bash
# config.env — настройки репутационной блокировки
# Измените значения под свои нужды перед запуском install.sh

# Защищаемые порты (через пробел)
PORTS="443"

# Свои IP/подсети, которые никогда не блокировать (через пробел)
# Оставьте пустым, если whitelist не нужен
WHITELIST=""

# Имя ipset-набора (не менять без необходимости)
IPSET_NAME="reputation_blocklist"

# Префикс в логах iptables
LOG_PREFIX="IPTABLES-REPBLOCK: "

# Файл для логов дропов
LOG_FILE="/var/log/iptables-repblock.log"

# Максимальный размер ipset
MAXELEM=65536
HASHSIZE=16384