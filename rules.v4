# Вставьте этот блок в ваш /etc/iptables/rules.v4 (или примените через iptables-restore).
# Убедитесь, что цепочки не конфликтуют с существующими правилами.
# Порядок: whitelist -> blocklist -> ACCEPT.

# 1. Цепочка логгирования дропов (создаётся один раз)
:BLOCKLIST_LOG_DROP - [0:0]
-A BLOCKLIST_LOG_DROP -m conntrack --ctstate NEW -m limit --limit 1/min --limit-burst 5 -j LOG --log-prefix "IPTABLES-REPBLOCK: " --log-level 4
-A BLOCKLIST_LOG_DROP -j DROP

# 2. Правила INPUT (по одному блоку на каждый защищаемый порт)
# Пример для порта 443:
-A INPUT -p tcp --dport 443 -m set --match-set whitelist src -j ACCEPT
-A INPUT -p tcp --dport 443 -m set --match-set reputation_blocklist src -j BLOCKLIST_LOG_DROP
-A INPUT -p tcp --dport 443 -j ACCEPT

# Для дополнительных портов просто скопируйте три строки выше, заменив 443.